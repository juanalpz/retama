# puerto donde escucha la api
PORT=3000

# conexion a postgres (los valores coinciden con docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=retama_db

# base que usan los tests (npm test). se crea sola si no existe y se vacia en cada corrida
DB_NAME_TEST=retama_test

# clave para firmar los tokens jwt. usar un valor largo y propio
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta

# origenes del front que pueden llamar a la api, separados por coma
CORS_ORIGIN=http://localhost:5173
