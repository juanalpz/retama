### Variables Globales de Entorno Local
@baseUrl = http://localhost:3000/api
@contentType = application/json

# ==========================================
# LOGIN PARA OBTENER TOKEN DE PRUEBA
# ==========================================
# @name loginResponse
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "juana.lopez@retama.com.ar",
  "password": "123456"
}

### Extraemos el token para las peticiones
@authToken = {{loginResponse.response.body.token}}


# ==========================================
# 8. ACTIVIDAD / FEED DE NOTIFICACIONES
# ==========================================

# ------------------------------------------
# 8.1 Listar el feed de actividad
# ------------------------------------------

### 8.1.a Obtener feed completo del vendedor (Protegido - 200)
GET {{baseUrl}}/vendedor/actividad
Authorization: Bearer {{authToken}}

### 8.1.b Filtrar feed por tipo (ej. COMENTARIO) (Protegido - 200)
GET {{baseUrl}}/vendedor/actividad?tipo=COMENTARIO
Authorization: Bearer {{authToken}}


# ------------------------------------------
# 8.2 Conteo de notificaciones sin leer
# ------------------------------------------

### 8.2.a Obtener número de notificaciones sin leer para el badge (Protegido - 200)
GET {{baseUrl}}/vendedor/actividad/sin-leer
Authorization: Bearer {{authToken}}


# ------------------------------------------
# 8.3 y 8.4 Marcar como leídas
# ------------------------------------------

### Extraer ID de la primera notificación para el siguiente test
# (Asegúrate de haber corrido 8.1.a primero)
# Si no, reemplaza el ID manualmente en 8.3.a
# @activityId = {{getFeed.response.body.data[0].id}}

### 8.3.a Marcar una notificación individual como leída (Protegido - 200)
# Reemplazar "1" con el ID real de una actividad de la BD
PATCH {{baseUrl}}/vendedor/actividad/1/leer
Authorization: Bearer {{authToken}}

### 8.4.a Marcar TODAS las notificaciones como leídas (Protegido - 200)
PATCH {{baseUrl}}/vendedor/actividad/leer-todas
Authorization: Bearer {{authToken}}

### 8.2.b Verificar conteo después de marcar como leído (Debería ser 0)
GET {{baseUrl}}/vendedor/actividad/sin-leer
Authorization: Bearer {{authToken}}
