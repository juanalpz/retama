# variables para docker compose. copiar este archivo como ".env" en la misma carpeta.
# todas tienen un valor por defecto: sin el archivo .env la app levanta igual.

# clave para firmar los tokens de sesion. usar un texto largo y propio.
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta

# contraseña de la base de datos
DB_PASSWORD=postgres

# puerto de la pc donde queda disponible la app
WEB_PORT=8080
